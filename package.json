{
  "name": "base-ui-mcp-server",
  "version": "1.0.0-beta.2",
  "description": "MCP server for Base UI React components - enables AI assistants to interact with Base UI component library",
  "main": "dist/index.js",
  "type": "module",
  "bin": {
    "base-ui-mcp": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/morksen123/base-ui-mcp-server.git"
  },
  "homepage": "https://github.com/morksen123/base-ui-mcp-server#readme",
  "bugs": {
    "url": "https://github.com/morksen123/base-ui-mcp-server/issues"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "start": "node dist/index.js",
    "mcp": "node dist/index.js",
    "mcp:inspect": "npx @modelcontextprotocol/inspector node dist/index.js mcp",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "base-ui",
    "react",
    "components",
    "ai",
    "assistant",
    "model-context-protocol"
  ],
  "author": {
    "name": "morksen123",
    "url": "https://github.com/morksen123"
  },
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "dedent": "^1.6.0",
    "execa": "^9.6.0",
    "fuzzysort": "^3.1.0",
    "https-proxy-agent": "^7.0.6",
    "node-fetch": "^3.3.2",
    "ora": "^9.0.0",
    "zod": "^3.22.4",
    "zod-to-json-schema": "^3.24.6"
  },
  "devDependencies": {
    "@types/node": "^20.19.20",
    "tsup": "^8.5.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
